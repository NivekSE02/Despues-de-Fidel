---
import Layout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.tsx';
import Hero from '../components/Hero.tsx';
import Interlude from '../components/Interlude.tsx';
import Discography from '../components/Discography.tsx';
import TourSection from '../components/TourSection.tsx';
import Footer from '../components/Footer.tsx';
---

<Layout>
  <Header client:load />
  <main class="flex-grow">
    <Hero client:load />
    <Interlude client:visible />
    <Discography client:visible />
    <TourSection client:visible />
  </main>
  <Footer />
</Layout>
